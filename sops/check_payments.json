{
  "version": "v0",
  "id": "check_payments",
  "name": "check_payments",
  "description": "Cron SOP that queries active pending invoices and performs Atomic Two-Step Verification (getSignaturesForAddress + getTransaction) via Gold Standard Token Balance Delta (meta.postTokenBalances - meta.preTokenBalances) and recursive inner instruction inspection with empty pending list guards.",
  "trigger": {
    "type": "cron",
    "schedule": "*/10 * * * * *"
  },
  "steps": [
    {
      "id": "fetch_pending_invoices",
      "step_id": "fetch_pending_invoices",
      "action": "http_request",
      "method": "GET",
      "url": "${POS_BACKEND_URL:-http://127.0.0.1:8080}/api/v1/invoices?status=pending"
    },
    {
      "id": "guard_empty_pending",
      "step_id": "guard_empty_pending",
      "action": "condition",
      "if": "fetch_pending_invoices.body.length == 0",
      "then": [
        {
          "action": "log",
          "message": "No pending invoices found. Sleeping until next cron iteration."
        }
      ],
      "else": [
        {
          "id": "fetch_signatures",
          "step_id": "fetch_signatures",
          "action": "solana_rpc_call",
          "method": "getSignaturesForAddress",
          "params": [
            "${fetch_pending_invoices.body.0.reference_pubkey}",
            { "limit": 1, "commitment": "${REQUIRED_COMMITMENT}" }
          ],
          "on_error": "retry_with_backoff",
          "retry_policy": {
            "max_retries": 3,
            "initial_delay_ms": 1000,
            "backoff_factor": 2.0,
            "handle_status_codes": [429, 502, 503, 504]
          }
        },
        {
          "id": "fetch_transaction_detail",
          "step_id": "fetch_transaction_detail",
          "action": "solana_rpc_call",
          "method": "getTransaction",
          "params": [
            "${fetch_signatures.0.signature}",
            { "encoding": "jsonParsed", "maxSupportedTransactionVersion": 0, "commitment": "${REQUIRED_COMMITMENT}" }
          ],
          "on_error": "retry_with_backoff"
        },
        {
          "id": "verify_via_backend",
          "step_id": "verify_via_backend",
          "action": "http_request",
          "method": "POST",
          "url": "${POS_BACKEND_URL:-http://127.0.0.1:8080}/api/v1/invoices/verify-transaction",
          "body": {
            "invoice_id": "${fetch_pending_invoices.body.0.id}",
            "tx_json": "${fetch_transaction_detail}"
          }
        },
        {
          "id": "evaluate_payment",
          "step_id": "evaluate_payment",
          "action": "condition",
          "if": "verify_via_backend.body.is_valid == true",
          "then": [
            {
              "action": "send_channel_message",
              "channel": "telegram",
              "recipient": "${MANAGER_TELEGRAM_ID}",
              "message": "✅ **Оплату підтверджено!**\n• Чек: #${fetch_pending_invoices.body.0.id}\n• Сигнатура: `${fetch_signatures.0.signature}`\n• Explorer: https://solscan.io/tx/${fetch_signatures.0.signature}"
            }
          ],
          "else": [
            {
              "action": "log",
              "message": "Waiting for valid SPL token payment transfer to Merchant ATA on reference key..."
            }
          ]
        }
      ]
    }
  ]
}
