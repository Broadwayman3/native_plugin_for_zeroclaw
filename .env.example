# ZeroClaw Environment Variables Example (Solana Devnet Defaults)

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Telegram Webhook Configuration (Optional for Webhook mode)
TELEGRAM_WEBHOOK_URL="https://your-domain.com/api/v1/telegram/webhook"
TELEGRAM_BOT_SECRET_TOKEN="your_random_secret_token_123456"

# Authorized Manager Telegram Chat ID (for receiving refund approval checkpoints)
MANAGER_TELEGRAM_ID="987654321"

# Solana RPC URL (Helius Devnet / QuickNode / Solana Devnet)
# Recommended for 100% reference key indexing: https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
SOLANA_RPC_URL="https://api.devnet.solana.com"
SOLANA_FALLBACK_RPC_URL="https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY"

# Merchant Wallet Address (Tier 1 Non-custodial destination for customer payments)
MERCHANT_WALLET_PUBKEY="8xAZ...YOUR_MERCHANT_SOLANA_ADDRESS"

# Refund Session Wallet Secret Key (Tier 2 Session key with micro-balance for refunds)
REFUND_SESSION_KEY="[12,34,56,...YOUR_SECRET_KEY_ARRAY]"

# Pre-funded Solana Nonce Account Pubkey (for Durable Nonce refund transactions)
NONCE_ACCOUNT_PUBKEY="Nonce111111111111111111111111111111111111111"

# Squads v4 Multisig & Vault Pubkeys (Devnet/Mainnet)
SQUADS_MULTISIG_PUBKEY="SqdsMultisig1111111111111111111111111111111"
SQUADS_VAULT_PUBKEY="SqdsVault11111111111111111111111111111111111"

# USDC Mint Address on Solana (Devnet default: 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU | Mainnet: EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v)
USDC_MINT_ADDRESS="4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU"

# Log Filtering (Clean 12-factor stdout logging without crate noise)
RUST_LOG="pos_backend=info,pos_core_logic=info,reqwest=warn,hyper=warn,h2=warn,tower_http=warn,deadpool_sqlite=warn"

