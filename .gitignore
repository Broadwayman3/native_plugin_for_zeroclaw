data/
*.db
*.db-wal
*.db-shm
*.sqlite

# Python caches
__pycache__/
*.pyc
.pytest_cache/

# Script artifacts
scripts/data/

# OS metadata
.DS_Store

# Local private operator notes & keys
docs/PRIVATE_OPERATOR_NOTES.md
*.local.md

