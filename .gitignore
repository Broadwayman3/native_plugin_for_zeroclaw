# Rust WASM build target & compiled WebAssembly modules
/target/
*.wasm
!plugins/solana-pos-core/target/
plugins/solana-pos-core/target/*
!plugins/solana-pos-core/target/wasm32-wasip2/
plugins/solana-pos-core/target/wasm32-wasip2/*
!plugins/solana-pos-core/target/wasm32-wasip2/release/
plugins/solana-pos-core/target/wasm32-wasip2/release/*
!plugins/solana-pos-core/target/wasm32-wasip2/release/solana_pos_core.wasm


# Environment and runtime configs
.env
config.toml

# ZeroClaw runtime data & SQLite databases
data/
*.db
*.db-wal
*.db-shm
*.sqlite

# Python caches
__pycache__/
*.pyc

# OS metadata
.DS_Store
